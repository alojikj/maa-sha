{
    "interface_version": 2,
    "name": "MaaXXX",
    "description": "这是一个使用 MaaFramework 创建的名将杀刷军令状的脚本。",
    "contact": "QQ:3626767662",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    "github": "https://github.com/alojikj/maa-sha",
    "version": "1.0.0",
   
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos", 
                "keyboard": "PostMessageWithCursorPos" 
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "大厅界面自动刷军令状",
            "entry": "大厅界面",
            "description": "大厅界面入口：在大厅界面使用，模拟器分辨率为1920x1080，理论上同比例的分辨率都可以。游戏设置中的操作要打开234568，关闭127（从左往右，从上往下数，比如最右上为2，最左下为7）"
        }
    ]
}